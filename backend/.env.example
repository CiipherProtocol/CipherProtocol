PORT=5001

# Postgres connection string for production. If unset, the backend falls
# back to a local SQLite file at ./data/dev.sqlite3 (zero-setup local dev).
DATABASE_URL=

SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
ORDER_VAULT_CONTRACT=
SETTLEMENT_ENGINE_CONTRACT=

# Secret key of the identity both contracts were `initialize`d with as admin.
# Signs every on-chain call the backend makes.
BACKEND_SIGNER_SECRET=

# Comma-separated symbol:contractAddress pairs, e.g. USDC:C...,USDT:C...
TOKEN_CONTRACTS=

BATCH_SIZE=100
BATCH_TIMEOUT_MS=30000
