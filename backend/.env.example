PORT=5001

# Postgres connection string for production. If unset, the backend falls
# back to a local SQLite file at ./data/dev.sqlite3 (zero-setup local dev).
DATABASE_URL=

SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
ORDER_VAULT_CONTRACT=
SETTLEMENT_ENGINE_CONTRACT=

# Secret key of the identity both contracts were `initialize`d with as admin.
# Signs every on-chain call the backend makes.
BACKEND_SIGNER_SECRET=

# Comma-separated symbol:contractAddress pairs, e.g. USDC:C...,USDT:C...
TOKEN_CONTRACTS=

BATCH_SIZE=100
BATCH_TIMEOUT_MS=30000

# Simulated validator set: any VALIDATOR_THRESHOLD of VALIDATOR_COUNT shares
# decrypt an order; fewer reveal nothing. Key shares are generated on first
# start by a distributed key generation among the validators; each
# validator's own share is kept in data/validators/validator-<i>.json
# (dev only, gitignored). Delete the directory to re-run DKG.
VALIDATOR_COUNT=5
VALIDATOR_THRESHOLD=3
# Indices of validators that return invalid shares, to demo proof checking.
BYZANTINE_VALIDATORS=

# HMAC key for wallet-signature auth challenges and session tokens (>= 32
# chars). Generate with: openssl rand -hex 32
AUTH_TOKEN_SECRET=

# Run validators as separate processes instead of in-process:
#   npm run validators:dev   (starts 5 validator processes, writes the file below)
# then start the backend with this set. The first start runs the DKG over HTTP.
VALIDATOR_CLUSTER_FILE=
